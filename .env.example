# Environment variables for local development (copy to .env)

# Shared secrets (must match across all services)
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long
GATEWAY_TOKEN=gateway-internal-token

# User Service
USER_SERVER_PORT=8081
USER_MYSQL_URL=jdbc:mysql://localhost:3306/user_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
USER_MYSQL_USER=user_app
USER_MYSQL_PASSWORD=user_secret

# Notification Service
NOTIFICATION_SERVER_PORT=8082
NOTIFICATION_MYSQL_URL=jdbc:mysql://localhost:3306/notification_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
NOTIFICATION_MYSQL_USER=notification_app
NOTIFICATION_MYSQL_PASSWORD=notification_secret

# NATS
NATS_URL=nats://localhost:4222
NATS_USER_PUBLISHER=app_user
NATS_USER_CONSUMER=notification_user
NATS_PASSWORD=nats_secret

# API Gateway
GATEWAY_SERVER_PORT=8080
USER_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:3000
